IDENTIFICATION DIVISION.
PROGRAM-ID. F14-QUARANTINE-BAD-RECS.
*> Validates payment records before posting to avoid S0C7.
*> Layout: PAY-ID(4) PAY-DATE(8) PAY-AMT(8). Bad rows go to err.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT PAY-IN-FILE ASSIGN TO "payments.dat"
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-IN-STAT.
    SELECT VALID-FILE ASSIGN TO "valid_pay.dat"
        ORGANIZATION IS LINE SEQUENTIAL.
    SELECT ERR-FILE ASSIGN TO "error_pay.dat"
        ORGANIZATION IS LINE SEQUENTIAL.

DATA DIVISION.
FILE SECTION.
FD  PAY-IN-FILE.
01  PAY-IN-REC.
    05  PAY-ID          PIC X(4).
    05  PAY-DATE        PIC X(8).
    05  PAY-AMT         PIC X(8).

FD  VALID-FILE.
01  VALID-REC           PIC X(20).

FD  ERR-FILE.
01  ERR-REC             PIC X(40).

WORKING-STORAGE SECTION.
01  WS-IN-STAT          PIC X(2) VALUE SPACES.
01  WS-EOF              PIC X(1) VALUE "N".
01  WS-DATE-NUM         PIC 9(8) VALUE 0.
01  WS-VALID-CNT        PIC 9(5) VALUE 0.
01  WS-ERR-CNT          PIC 9(5) VALUE 0.

PROCEDURE DIVISION.
0000-MAIN.
    OPEN INPUT PAY-IN-FILE
    IF WS-IN-STAT NOT = "00"
        DISPLAY "INPUT OPEN FAILED: " WS-IN-STAT
        STOP RUN
    END-IF

    OPEN OUTPUT VALID-FILE ERR-FILE

    PERFORM UNTIL WS-EOF = "Y"
        READ PAY-IN-FILE
            AT END
                MOVE "Y" TO WS-EOF
            NOT AT END
                PERFORM 2000-VALIDATE-REC
        END-READ
    END-PERFORM

    CLOSE PAY-IN-FILE VALID-FILE ERR-FILE
    DISPLAY "VALID: " WS-VALID-CNT " ERRORS: " WS-ERR-CNT
    STOP RUN.

2000-VALIDATE-REC.
    IF PAY-ID = SPACES
       OR PAY-AMT IS NOT NUMERIC
       OR PAY-DATE IS NOT NUMERIC
        PERFORM 2100-WRITE-ERROR
        EXIT PARAGRAPH
    END-IF

    MOVE PAY-DATE TO WS-DATE-NUM
    IF FUNCTION TEST-DATE-YYYYMMDD(WS-DATE-NUM) NOT = 0
        PERFORM 2100-WRITE-ERROR
    ELSE
        WRITE VALID-REC FROM PAY-IN-REC
        ADD 1 TO WS-VALID-CNT
    END-IF.

2100-WRITE-ERROR.
    MOVE SPACES TO ERR-REC
    STRING PAY-IN-REC DELIMITED BY SIZE
           " ERR-DATA-FORMAT" DELIMITED BY SIZE
      INTO ERR-REC
    END-STRING
    WRITE ERR-REC
    ADD 1 TO WS-ERR-CNT.
