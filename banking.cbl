IDENTIFICATION DIVISION.
PROGRAM-ID. BANKING.

DATA DIVISION.
WORKING-STORAGE SECTION.
01 WS-BALANCE PIC 9(6)V99 VALUE 10000.00.
01 WS-AMOUNT PIC 9(6)V99 VALUE ZERO.
01 WS-CHOICE PIC 9 VALUE ZERO.

PROCEDURE DIVISION.

MAIN-PARA.
    DISPLAY "========================".
    DISPLAY "     BANKING SYSTEM".
    DISPLAY "========================".
    DISPLAY "1. CHECK BALANCE".
    DISPLAY "2. DEPOSIT MONEY".
    DISPLAY "3. WITHDRAW MONEY".
    DISPLAY "4. EXIT".
    DISPLAY "ENTER YOUR CHOICE:".

    ACCEPT WS-CHOICE.

    EVALUATE WS-CHOICE
        WHEN 1
            PERFORM CHECK-BALANCE
        WHEN 2
            PERFORM DEPOSIT-MONEY
        WHEN 3
            PERFORM WITHDRAW-MONEY
        WHEN 4
            DISPLAY "THANK YOU FOR BANKING!"
        WHEN OTHER
            DISPLAY "INVALID CHOICE"
    END-EVALUATE.

    STOP RUN.

CHECK-BALANCE.
    DISPLAY "CURRENT BALANCE: " WS-BALANCE.

DEPOSIT-MONEY.
    DISPLAY "ENTER DEPOSIT AMOUNT:".
    ACCEPT WS-AMOUNT

    IF WS-AMOUNT > ZERO
        ADD WS-AMOUNT TO WS-BALANCE
        DISPLAY "DEPOSIT SUCCESSFUL"
        DISPLAY "NEW BALANCE: " WS-BALANCE
    ELSE
        DISPLAY "INVALID AMOUNT"
    END-IF.

WITHDRAW-MONEY.
    DISPLAY "ENTER WITHDRAWAL AMOUNT:".
    ACCEPT WS-AMOUNT

    IF WS-AMOUNT > ZERO AND WS-AMOUNT <= WS-BALANCE
        SUBTRACT WS-AMOUNT FROM WS-BALANCE
        DISPLAY "WITHDRAWAL SUCCESSFUL"
        DISPLAY "NEW BALANCE: " WS-BALANCE
    ELSE
        DISPLAY "INSUFFICIENT BALANCE OR INVALID AMOUNT"
    END-IF.
