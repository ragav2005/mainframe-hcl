IDENTIFICATION DIVISION.
PROGRAM-ID. SHORT-TRANSFER.

DATA DIVISION.
WORKING-STORAGE SECTION.
01  TEST-DATA.
    05 FILLER PIC X(24) VALUE "000800000002000000010000".
    05 FILLER PIC X(24) VALUE "000500000001500000050000".
    05 FILLER PIC X(24) VALUE "000300000004000000035000".
    05 FILLER PIC X(24) VALUE "001000000005000000000000".
    
01  TEST-TABLE REDEFINES TEST-DATA.
    05 TC OCCURS 4 TIMES.
       10 IN-SRC      PIC 9(6)V99.
       10 IN-DST      PIC 9(6)V99.
       10 IN-AMT      PIC 9(6)V99.

01  TEST-NUM          PIC 9 VALUE 1.
01  SRC-BAL           PIC S9(6)V99.
01  DST-BAL           PIC S9(6)V99.
01  PRE-SUM           PIC S9(7)V99.

01  STATUS-TXT        PIC X(8).
01  PROP-TXT          PIC X(4).

01  D-IN-SRC          PIC ZZZ,ZZ9.99.
01  D-IN-DST          PIC ZZZ,ZZ9.99.
01  D-IN-AMT          PIC ZZZ,ZZ9.99.
01  D-OUT-SRC         PIC ZZZ,ZZ9.99.
01  D-OUT-DST         PIC ZZZ,ZZ9.99.

PROCEDURE DIVISION.
MAIN-LOGIC.
    PERFORM VARYING TEST-NUM FROM 1 BY 1 UNTIL TEST-NUM > 4
        MOVE IN-SRC(TEST-NUM) TO SRC-BAL
        MOVE IN-DST(TEST-NUM) TO DST-BAL
        COMPUTE PRE-SUM = SRC-BAL + DST-BAL

        IF IN-AMT(TEST-NUM) > 0 AND SRC-BAL >= IN-AMT(TEST-NUM)
            SUBTRACT IN-AMT(TEST-NUM) FROM SRC-BAL
            ADD      IN-AMT(TEST-NUM) TO   DST-BAL
            MOVE "APPROVED" TO STATUS-TXT
        ELSE
            MOVE "REJECTED" TO STATUS-TXT
        END-IF

        IF (SRC-BAL + DST-BAL = PRE-SUM) AND 
           (SRC-BAL >= 0) AND (DST-BAL >= 0)
            MOVE "PASS" TO PROP-TXT
        ELSE
            MOVE "FAIL" TO PROP-TXT
        END-IF

        MOVE IN-SRC(TEST-NUM)  TO D-IN-SRC
        MOVE IN-DST(TEST-NUM)  TO D-IN-DST
        MOVE IN-AMT(TEST-NUM)  TO D-IN-AMT
        MOVE SRC-BAL           TO D-OUT-SRC
        MOVE DST-BAL           TO D-OUT-DST

        DISPLAY "TEST " TEST-NUM ": " STATUS-TXT 
                " | (" FUNCTION TRIM(D-IN-SRC) ", " 
                       FUNCTION TRIM(D-IN-DST) ") -[" 
                       FUNCTION TRIM(D-IN-AMT) "]-> (" 
                       FUNCTION TRIM(D-OUT-SRC) ", " 
                       FUNCTION TRIM(D-OUT-DST) ")"
                " | Invariant Check: " PROP-TXT
    END-PERFORM.

    STOP RUN.
